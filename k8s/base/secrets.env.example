# Secrets de la plateforme, injectes par Kustomize dans un Secret Kubernetes.
#
# Copier ce fichier en `secrets.env` et y mettre de vraies valeurs :
#     cp k8s/base/secrets.env.example k8s/base/secrets.env
#
# `secrets.env` est exclu du depot. AUCUNE valeur ci-dessous n'est un secret
# reel : ce sont des exemples pour un environnement de developpement.
MINIO_ROOT_USER=waba_admin
MINIO_ROOT_PASSWORD=waba_dev_password_change_me

AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow_dev_password_change_me
AIRFLOW_ADMIN_PASSWORD=admin

GOVERNANCE_DB_USER=waba
GOVERNANCE_DB_PASSWORD=waba_governance_password_change_me

# NiFi 2 impose un mot de passe d'au moins 12 caracteres, sinon le serveur
# refuse de demarrer.
NIFI_USERNAME=waba_admin
NIFI_PASSWORD=waba_nifi_dev_password

SUPERSET_SECRET_KEY=waba_superset_dev_secret_change_me
SUPERSET_DATABASE_URI=postgresql+psycopg2://waba:waba_governance_password_change_me@governance-db.waba-governance.svc.cluster.local/superset

GRAFANA_ADMIN=admin
GRAFANA_ADMIN_PASSWORD=admin

# Airflow se rabat sur SQLite si cette chaine manque, et le LocalExecutor la
# refuse : le service demarre puis s'arrete sur un message qui ne dit pas que
# la configuration est incomplete.
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow_dev_password_change_me@airflow-db.waba-processing.svc.cluster.local/airflow
