# =============================================================================
# WABA Group — Plateforme Analytique Financière Multi-Pays
# Variables d'environnement. Copier ce fichier en `.env` avant tout démarrage :
#
#     cp README.env.example .env        (Linux / macOS)
#     Copy-Item README.env.example .env (Windows PowerShell)
#
# AUCUNE valeur ci-dessous n'est un secret réel : ce sont des valeurs d'exemple
# destinées à un environnement de développement local.
# =============================================================================

# --- Versions des images (épinglées pour la reproductibilité) ----------------
MINIO_IMAGE=minio/minio:latest
MC_IMAGE=minio/mc:latest
ICEBERG_REST_IMAGE=apache/iceberg-rest-fixture:1.9.1
TRINO_IMAGE=trinodb/trino:476

# --- MinIO (Object Storage) --------------------------------------------------
MINIO_ROOT_USER=waba_admin
MINIO_ROOT_PASSWORD=waba_dev_password_change_me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Buckets — cf. Level 1.2 du sujet
BUCKET_RAW=raw-landing
BUCKET_LAKEHOUSE=lakehouse
BUCKET_ARCHIVE=archive

# --- Catalogue Iceberg (REST) ------------------------------------------------
ICEBERG_REST_PORT=8181
ICEBERG_WAREHOUSE=s3://lakehouse/

# --- Trino -------------------------------------------------------------------
TRINO_PORT=8080

# --- Générateur (application Streamlit) --------------------------------------
STREAMLIT_PORT=8501
# Vu depuis un conteneur de la stack : http://minio:9000
# Vu depuis la machine hôte (développement local) : http://localhost:9000
MINIO_ENDPOINT=http://minio:9000
# Clé de pseudonymisation des données personnelles. En production, elle
# proviendrait d'un secret Kubernetes ; la laisser vide active une clé de
# repli de développement, et l'application le signale explicitement.
WABA_PII_KEY=
# Taux de sinistralité du cedi ghanéen face à l'euro. Le franc CFA, lui, a une
# parité fixe et n'est donc pas paramétrable.
WABA_GHS_PER_EUR=17.5

# --- Airflow (Level 2) --------------------------------------------------------
AIRFLOW_PORT=8090
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow_dev_password_change_me
AIRFLOW_ADMIN_PASSWORD=admin
# Clé de chiffrement des Connections Airflow. Laissée vide en développement ;
# en production, générer avec :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# Pays traités par défaut par les DAGs. Chaque exécution peut les restreindre.
WABA_COUNTRIES=CI,SN,ML,BF,GN,TG,BJ,GH
POSTGRES_IMAGE=postgres:16-alpine

# --- Level 3 : streaming ------------------------------------------------------
KAFKA_IMAGE=apache/kafka:3.9.0
KAFKA_PORT=9092
KAFKA_PARTITIONS=3

NIFI_IMAGE=apache/nifi:2.2.0
NIFI_PORT=8091
NIFI_USERNAME=waba_admin
# NiFi 2 impose HTTPS et une authentification mono-utilisateur : le mot de passe
# doit faire au moins 12 caractères, sinon le serveur refuse de démarrer.
NIFI_PASSWORD=waba_nifi_dev_password

# Tolérance au désordre des règles à fenêtre du Job 2. Elle porte sur
# l'horodatage métier et doit couvrir l'étalement temporel complet du jeu rejoué,
# pas seulement le retard attendu d'un événement : un fichier historique arrivant
# après un fichier plus récent verrait sinon tous ses événements écartés comme
# tardifs. En production, quelques minutes suffisent.
WABA_STREAM_WATERMARK=3 days

# Délai de grâce avant archivage. NiFi surveille la même zone d'atterrissage que
# le job batch : archiver un fichier avant qu'il ne l'ait recensé le ferait
# disparaître du chemin streaming sans laisser de trace.
WABA_ARCHIVE_AFTER_MINUTES=10
# Part des encours d'un pays au-delà de laquelle les sorties nettes déclenchent
# une alerte de liquidité. La valeur réglementaire est 0.02 ; sur un jeu de
# données échantillonné le ratio observé reste inférieur au millionième, et
# abaisser ce seuil permet de démontrer le mécanisme. Chaque alerte enregistre
# le seuil qui l'a produite.
WABA_LIQUIDITY_RATIO=0.02

# --- Divers ------------------------------------------------------------------
AWS_REGION=us-east-1
TZ=UTC

# --- Level 4 : visualisation et gouvernance ------------------------------------
# Base de métadonnées partagée par Superset, Keycloak et OpenMetadata.
GOVERNANCE_DB_USER=waba
GOVERNANCE_DB_PASSWORD=waba_governance_password_change_me

SUPERSET_PORT=8088
SUPERSET_ADMIN=admin
SUPERSET_ADMIN_PASSWORD=admin
# Clé de signature des sessions Superset. En production, la générer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(42))"
SUPERSET_SECRET_KEY=waba_superset_dev_secret_change_me
# Utilisateur présenté à Trino par Superset. Trino n'authentifie pas en local ;
# le Level 4 place Keycloak devant et cette valeur devient un vrai principal.
TRINO_USER=waba
# Adresse de Trino telle que Superset la voit : le serveur ouvre lui-même la
# connexion, depuis le réseau Compose et non depuis le poste de travail.
WABA_TRINO_URI=trino://waba@trino:8080/iceberg

# --- Level 4 : observabilité ---------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN=admin
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_IMAGE=prom/prometheus:v3.1.0
GRAFANA_IMAGE=grafana/grafana:11.5.1
LOKI_IMAGE=grafana/loki:3.3.2
PROMTAIL_IMAGE=grafana/promtail:3.3.2
KAFKA_EXPORTER_IMAGE=danielqsj/kafka-exporter:v1.9.0
STATSD_EXPORTER_IMAGE=prom/statsd-exporter:v0.28.0
PYTHON_IMAGE=python:3.12-alpine
